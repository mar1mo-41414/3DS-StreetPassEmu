# wifit3 (tools/wifit3) がsudo無し・ユーザー権限だけでUSB Wi-Fiアダプタに
# 直接アクセスできるようにするudevルール。
#
# wifit3はモニターモード(root権限が必要)を使わず、対応チップセットに
# 直接libusb経由で命令を送ることで3DSすれちがい通信をエミュレートする
# ツールのため、本来sudoは不要なはず — このルールが無いとUSBデバイス
# ノードがroot専用パーミッションのままになり、結果的にsudoが必要に
# 見えてしまう。
#
# 対象VID:PIDは tools/wifit3/src/wifit3/chips/*/__init__.py に定義されて
# いる対応チップセット一覧から抽出(2026-09-15時点)。
#
# インストール:
#   sudo cp 99-wifit3.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#   (自分のユーザーがplugdevグループに入っていることを確認: groups)
#
SUBSYSTEM=="usb", ATTRS{idVendor}=="03f0", ATTRS{idProduct}=="ca02", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0409", ATTRS{idProduct}=="0408", GROUP="plugdev", MODE="0660"
SUBSYSTEM=="usb", ATTRS{idVendor}=="040d", ATTRS{idProduct}=="3801", GROUP="plugdev", MODE="0660"
